{
  "title": "15. Finding the Unknown",
  "tests": [
    { "q": [
      { "t": "Solve 2n + 1 = 99.", "n": 49, "k": "(99-1)//2", "e": "Subtract 1: 2n = 98. Divide by 2: n = 49." },
      { "t": "Solve 2e = 6.", "n": 3, "e": "Divide both sides by 2." },
      { "t": "Solve 4 + 2y = 16.", "n": 6, "k": "(16-4)//2", "e": "Take 4 off both sides: 2y = 12, so y = 6." },
      { "t": "Solve 3x − 10 = 35.", "n": 15, "k": "(35+10)//3", "e": "Add 10: 3x = 45. Divide by 3: x = 15." },
      { "t": "Solve 11y + (−5) = 61.", "n": 6, "k": "(61+5)//11", "e": "Subtract (−5), i.e. add 5: 11y = 66, so y = 6." },
      { "t": "Solve 3u − 7 = 2u + 3.", "n": 10, "e": "Subtract 2u: u − 7 = 3. Add 7: u = 10." },
      { "t": "What keeps an equation balanced?", "o": ["Doing the same operation to both sides", "Changing only the LHS", "Adding to one side only", "Swapping numbers around"], "e": "Like a balanced scale: equal changes to both plates keep it level." },
      { "t": "Solve 13 − z = 8.", "n": 5, "e": "13 − 5 = 8, so z = 5 (or add z and subtract 8 from both sides)." },
      { "t": "Can a matchstick pattern with 2n + 1 sticks use exactly 200 sticks?", "o": ["No — 2n + 1 is always odd", "Yes, n = 100", "Yes, n = 99", "Yes, n = 199"], "e": "2n is even, plus 1 is odd; 200 is even." },
      { "t": "Solve 2y = 60.", "n": 30, "k": "60//2", "e": "Divide both sides by 2." }
    ]},
    { "q": [
      { "t": "Solve 6y + 7 = 4y + 21.", "n": 7, "k": "(21-7)//(6-4)", "e": "Subtract 4y: 2y + 7 = 21. Subtract 7: 2y = 14. y = 7." },
      { "t": "Solve 5x − 4 = 7.", "o": ["11/5", "3/5", "11", "5/11"], "k": "F(11,5)", "e": "Add 4: 5x = 11. Divide by 5: x = 11/5." },
      { "t": "Ranjana's step k uses 3k + 1 tiles. Which step uses 100 tiles?", "n": 33, "k": "(100-1)//3", "e": "3k + 1 = 100 → 3k = 99 → k = 33." },
      { "t": "Snacks ₹25 a plate + ₹50 delivery, budget ₹500. How many plates?", "n": 18, "k": "(500-50)//25", "e": "25p + 50 = 500 → 25p = 450 → p = 18." },
      { "t": "Jahnavi: ₹4000 + ₹650 a month. Sunita: ₹5050 + ₹500 a month. Months until equal?", "n": 7, "k": "(5050-4000)//(650-500)", "e": "4000 + 650m = 5050 + 500m → 150m = 1050 → m = 7." },
      { "t": "Solve 4(m + 6) − 8 = 2m − 4.", "n": -10, "e": "4m + 24 − 8 = 2m − 4 → 4m + 16 = 2m − 4 → 2m = −20 → m = −10." },
      { "t": "Ramesh and Suresh have 60 marbles; Ramesh has 30 more. Suresh has…", "n": 15, "k": "(60-30)//2", "e": "y + (y + 30) = 60 → 2y = 30 → y = 15 (Ramesh 45)." },
      { "t": "Solve k + 8 = 12 − k.", "n": 2, "e": "Add k: 2k + 8 = 12. Subtract 8: 2k = 4. k = 2." },
      { "t": "Which equation has NO solution?", "o": ["x + 4 = x + 5", "2x = 0", "x + 4 = 5", "4x = 5"], "e": "Subtracting x leaves 4 = 5, which is never true." },
      { "t": "Solve −8 = 5x − 3.", "n": -1, "e": "Add 3: −5 = 5x. Divide by 5: x = −1." }
    ]},
    { "q": [
      { "t": "Solve 28(x + 4) + 300 = 1000.", "n": 21, "k": "(1000-300)//28-4", "e": "Subtract 300: 28(x + 4) = 700. Divide by 28: x + 4 = 25. x = 21." },
      { "t": "Think of x, subtract 3, multiply by 4, add 8. The result is 24. What was x?", "n": 7, "e": "4(x − 3) + 8 = 4x − 4 = 24 → 4x = 28 → x = 7." },
      { "t": "4x + 6 = 10 was solved as 4x = 10 + 6. The correct value of x is…", "n": 1, "k": "(10-6)//4", "e": "+6 crosses over as −6: 4x = 4, so x = 1." },
      { "t": "7 − 8z = 5 → 8z = 2 → z = 4. The correct z is…", "o": ["1/4", "4", "−1/4", "2"], "k": "F(2,8)", "e": "8z = 2 means z = 2 ÷ 8 = 1/4, not 8 ÷ 2." },
      { "t": "Solve 5z + 2 = 3z − 4.", "n": -3, "e": "Subtract 3z and 2: 2z = −6, so z = −3." },
      { "t": "A 3-digit number: hundreds = tens − 3, tens = units − 3, digit sum 15. The number?", "n": 258, "e": "a + (a + 3) + (a + 6) = 15 → a = 2 → digits 2, 5, 8." },
      { "t": "A brick weighs 1 kg more than half its weight. Its weight (kg)?", "n": 2, "e": "w = w/2 + 1 → w/2 = 1 → w = 2." },
      { "t": "Given 4k + 1 = 13, find 8k + 2 without finding k.", "n": 26, "k": "2*13", "e": "8k + 2 = 2(4k + 1) = 2 × 13 = 26." },
      { "t": "Taxi: ₹800 fixed + ₹20 per km, total ₹2200. Kilometres?", "n": 70, "k": "(2200-800)//20", "e": "800 + 20k = 2200 → 20k = 1400 → k = 70." },
      { "t": "Solve 7m = m − 3.", "o": ["−1/2", "1/2", "−2", "3/7"], "k": "F(-3,6)", "e": "Subtract m: 6m = −3 → m = −1/2." }
    ]},
    { "q": [
      { "t": "Bhāskara: ₹300 + 6 horses = 10 horses − ₹100 debt. Price of a horse (₹)?", "n": 100, "k": "(300+100)//(10-6)", "e": "300 + 6x = 10x − 100 → 400 = 4x → x = 100." },
      { "t": "Brahmagupta's formula for Ax + B = Cx + D gives x = ?", "o": ["(D − B) ÷ (A − C)", "(B − D) ÷ (A − C)", "(D + B) ÷ (A + C)", "(A − C) ÷ (D − B)"], "e": "Subtract Cx and B from both sides: (A − C)x = D − B, then divide." },
      { "t": "Use Brahmagupta's formula: 2x + 3 = 4x + 5.", "n": -1, "k": "F(5-3,2-4)", "e": "x = (5 − 3) ÷ (2 − 4) = 2 ÷ (−2) = −1." },
      { "t": "Bakhshālī: shares x, 2x, 3 × (2x), 4 × (6x) total 132. First share?", "n": 4, "k": "132//(1+2+6+24)", "e": "x + 2x + 6x + 24x = 33x = 132 → x = 4." },
      { "t": "28 heads and 80 feet among children and donkeys. How many donkeys?", "n": 12, "k": "(80-2*28)//2", "e": "4d + 2(28 − d) = 80 → 2d + 56 = 80 → d = 12 (and 16 children)." },
      { "t": "Solve −2(3 − 4x) = 14.", "o": ["5/2", "−5/2", "−1", "1"], "k": "F(20,8)", "e": "−6 + 8x = 14 (−2 × −4x = +8x) → 8x = 20 → x = 5/2." },
      { "t": "Solve 3(7y + 4) = 9 + 5y.", "o": ["−3/16", "3/16", "−1/4", "1/2"], "k": "F(-3,16)", "e": "21y + 12 = 9 + 5y → 16y = −3 → y = −3/16." },
      { "t": "Fruit juice costs ₹15 less than a milkshake; 4 juices + 7 milkshakes cost ₹600. Juice price (₹)?", "n": 45, "e": "4(m − 15) + 7m = 600 → 11m = 660 → m = 60, juice = 45." },
      { "t": "Given 28p − 36 = 98, find 14p − 19.", "n": 48, "e": "28p = 134, so 14p = 67 and 14p − 19 = 48." },
      { "t": "Solve 10 − 5x = 3(x − 4) − 2(x − 7).", "o": ["4/3", "3/4", "−4/3", "2"], "k": "F(8,6)", "e": "RHS = 3x − 12 − 2x + 14 = x + 2. So 10 − 5x = x + 2 → 8 = 6x → x = 4/3." }
    ]}
  ]
}
